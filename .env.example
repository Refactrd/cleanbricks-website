# Public site URL (no trailing slash). Used for canonical links, sitemap, structured data.
NEXT_PUBLIC_SITE_URL=https://cleanbricks.us

# Enquiry email via Resend (https://resend.com)
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "CleanBricks <bookings@cleanbricks.us>"
ENQUIRY_FROM_EMAIL=
# Where new enquiries are sent. Defaults to the site contact email.
ENQUIRY_TO_EMAIL=bookings@cleanbricks.us

# Optional: Google Sheet log via Apps Script (see docs/enquiries-google-sheet.gs)
ENQUIRY_WEBHOOK_URL=

# Optional: powers live address autocomplete on the booking calculator (Google Places API
# "New" + Geocoding, server-side only). Without it, the calculator falls back to the LGA
# dropdown and still prices correctly, just less precisely.
GOOGLE_MAPS_SERVER_API_KEY=
